# Windows VPS Agent Environment
# Copy to .env and fill in your values

# Remote Ubuntu server PostgreSQL
DATABASE_URL_SYNC=postgresql://postgres:YOUR_PASSWORD@91.98.20.163:5432/copytrade

# Remote Ubuntu server Redis
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@91.98.20.163:6379/0

# Encryption key for MT5 credentials (must match the API server key)
MT5_CREDENTIAL_KEY=your-32-byte-base64-key====

# MT5 Terminal path (Windows) — fallback if instance manager is not used
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Multi-instance management (REQUIRED for multiple simultaneous accounts)
# Base MT5 installation folder (will be copied for each account)
MT5_BASE_PATH=C:\Program Files\MetaTrader 5
# Directory where per-account MT5 copies are stored
MT5_INSTANCES_DIR=C:\MT5_Instances
# JSON file mapping account IDs to instance folders
MT5_INSTANCE_MAPPING_FILE=C:\MT5_Instances\instances.json
# Timeout for MT5 initialization per instance (ms)
MT5_INIT_TIMEOUT_MS=60000

# ── Client light mode (OFF by default) ──────────────────────────────
# When true, NEW client MT5 instance folders are created without heavy
# subdirs (Bases, MQL5/Experts, MQL5/Indicators, MQL5/Scripts, Templates,
# Profiles), and bootstrap writes a lighter common.ini (Experts disabled,
# News disabled, MaxBars reduced, no profile/template).
# - Masters are NEVER affected.
# - Existing client folders are NOT modified retroactively (recreate to apply).
# - Copy logic (distributor/executor/master_monitor) is unchanged.
AGENT_CLIENT_LIGHT=false
AGENT_CLIENT_LIGHT_SKIP_DIRS=Bases,MQL5/Experts,MQL5/Indicators,MQL5/Scripts,Templates,Profiles
AGENT_CLIENT_LIGHT_MAX_BARS=1000

# ── Close Reconciler (OFF by default) ────────────────────────────────
# Defensive verifier. After each CLOSE attempt the executor schedules an
# in-process verification that:
#   - confirms position is truly gone (FECHADO_OK / JA_NAO_EXISTE), or
#   - retries close at market price with progressive delays
# It NEVER closes unrelated positions and NEVER fires duplicate closes.
# Identification: client_ticket (preferred) or symbol + exact comment
# "CT:{master_ticket}" + magic match.
CLOSE_RECONCILER_ENABLED=false
CLOSE_RECONCILER_MAX_ATTEMPTS=5
CLOSE_RECONCILER_RETRY_DELAYS_SECONDS=2,5,10,20,30
CLOSE_RECONCILER_ACCEPT_MANUAL_CLOSE=true

# Polling interval (ms) — lower = faster detection, higher CPU
MASTER_POLL_INTERVAL_MS=50

# Max slippage in points before rejecting a copy
MAX_SLIPPAGE_POINTS=30

# How often to sync with PostgreSQL for new accounts (seconds)
DB_SYNC_INTERVAL_S=30
