# ── CopyTrade Pro V2 Agent — example env ──────────────────────
# Strict isolation from V1: V2_* prefix only.
# This file is specific for the Institutional V2 Windows VPS.

# ── Identification ──
V2_VPS_ID=institutional-01
V2_EXECUTOR_VERSION=v2

# ── Feature Flags ──
V2_MT5_POOL_V2_ENABLED=true
V2_HIGH_DENSITY_MODE=true
V2_WINDOWS_VPS_MONITOR_ENABLED=true
V2_MT5_TERMINALS_HIDDEN_MODE=true
V2_RESOURCE_GUARD_ENABLED=true
V2_EXECUTION_DEDUP_ENABLED=true
V2_INSTITUTIONAL_SAFE_MODE_ENABLED=true
V2_AUTO_ONBOARDING_ENABLED=true
V2_AUTO_REMOVE_DISCONNECTED_ACCOUNTS=false
V2_AUTO_RECOVERY_AFTER_REBOOT=false

# ── Remote Infrastructure (Linux) ──
# Note: V2 uses Redis DB /2 (V1 uses /0)
V2_DATABASE_URL_SYNC=postgresql://postgres:postgres@91.98.20.163:5432/copytrade
V2_REDIS_URL=redis://91.98.20.163:6379/2
V2_REDIS_PREFIX=copytrade_v2:

# ── Credentials Encryption ──
V2_MT5_CREDENTIAL_KEY=change-me-32-byte-base64-key====

# ── MT5 Terminal Binary ──
V2_MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
V2_MT5_BASE_PATH=C:\Program Files\MetaTrader 5

# ── V2 Isolated Paths (Must NOT overlap with V1) ──
V2_V2_ROOT=C:\copytrade_v2
V2_V2_MASTERS_DIR=C:\MT5_Masters_V2
V2_V2_POOL_DIR=C:\MT5_Pool_V2
V2_V2_LOGS_DIR=C:\copytrade_v2_logs

# ── Pool Sizing ──
V2_POOL_CAPACITY=15
V2_POOL_PREWARM_STANDBY=1
V2_POOL_AUTOPROVISION_ENABLED=true

# ── Execution Settings ──
V2_EXECUTION_MODE=DRY_RUN
V2_ORDER_EXECUTION_ENABLED=false

# ── Metrics ──
V2_METRICS_PORT=9091
