# MetaApi V3 Configuration
METAAPI_TOKEN=YOUR_METAAPI_TOKEN
METAAPI_ENABLED=true
COPYFACTORY_ENABLED=true
METAAPI_REGION=new-york
METAAPI_ACCOUNT_REPLICA_COUNT=1
METAAPI_DEFAULT_PLATFORM=mt5

# Environment Flag (homologation/production)
ENVIRONMENT=homologation
V3_FEATURE_FLAG=true

# Database
# Database - SQLite local para homologação
DATABASE_URL=sqlite+aiosqlite:///./copytrade_v3.db
DATABASE_URL_SYNC=sqlite:///./copytrade_v3.db

# Postgres opcional (descomente para usar)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/copytrade_v3
# DATABASE_URL_SYNC=postgresql://user:password@localhost:5432/copytrade_v3

