# ── Bridge (EA → API → Redis → Windows Executor) ──
# Feature flag — keep false until distributor and EA are validated.
BRIDGE_ENABLED=false
# Shared secret sent by the EA in `Authorization: Bearer <token>`
BRIDGE_TOKEN=change-me
# Redis pub/sub channel used by ingestion → distributor
BRIDGE_REDIS_CHANNEL_PREFIX=bridge:signal
# Per-client Redis list consumed by the Windows Executor (`<prefix>:<client_login>`)
BRIDGE_EXECUTE_QUEUE_PREFIX=bridge:execute
# Lot guard rails applied after proportional calculation
BRIDGE_MAX_LOT=100
BRIDGE_MIN_LOT=0.01
BRIDGE_DEFAULT_LOT_STEP=0.01
# Require active/trial subscription and access_status != blocked to receive copies
BRIDGE_REQUIRE_ACTIVE_SUBSCRIPTION=true
