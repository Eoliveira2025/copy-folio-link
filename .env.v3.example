# --- APP SETTINGS ---
APP_NAME=CopyTrade-Pro-V3
ENVIRONMENT=development
API_PREFIX=/api/v3
ALLOWED_ORIGINS=*

# --- DATABASE (SQLite for V3 Homologation) ---
# For SQLite use: sqlite+aiosqlite:///./copytrade_v3.db
# For Postgres use: postgresql+asyncpg://user:pass@localhost:5432/db
DATABASE_URL=sqlite+aiosqlite:///./copytrade_v3.db
DATABASE_URL_SYNC=sqlite:///./copytrade_v3.db
POSTGRES_PASSWORD=postgres_v3_pwd

# --- REDIS (DOCKER) ---
# ctv3-redis is the container name in docker-compose.v3.yml
REDIS_URL=redis://ctv3-redis:6379/0

# --- SECURITY ---
SECRET_KEY=generate-a-strong-secret-key-here
MT5_CREDENTIAL_KEY=generate-32-byte-base64-key

# --- METAAPI (V3) ---
METAAPI_ENABLED=false
COPYFACTORY_ENABLED=false
METAAPI_TOKEN=your_metaapi_token_here
METAAPI_REGION=new-york
METAAPI_ACCOUNT_REPLICA_COUNT=1
METAAPI_DEFAULT_PLATFORM=mt5
